\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Observational calibration and ESA Euclid forecast from the joint Pantheon+ (full covariance, $N=1,580$) + DESI Year~1 BAO ($N=12$) + Planck CMB shift prior ($N=1$) analysis. (a)~Fractional expansion-rate deviation $\Delta H(z)/H_{\Lambda \mathrm  {CDM}}(z)$ showing best-fit curves, $68\%$ MCMC posterior bands, and the ESA Euclid spectroscopic BAO sensitivity ($\sigma _H/H \approx 1.3\%$ per bin across $0.9 \le z \le 1.8$~\cite  {blanchard2020}). (b)~Dark energy equation of state $w(z)$ best-fit trajectories and $68\%$ posterior credible bands. (c)~Progressive model-selection criteria ($\Delta \chi ^2$, $\Delta \mathrm  {AIC}$, $\Delta \mathrm  {BIC}$) across dataset combinations.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:euclid}{{1}{4}{Observational calibration and ESA Euclid forecast from the joint Pantheon+ (full covariance, $N=1,580$) + DESI Year~1 BAO ($N=12$) + Planck CMB shift prior ($N=1$) analysis. (a)~Fractional expansion-rate deviation $\Delta H(z)/H_{\Lambda \mathrm {CDM}}(z)$ showing best-fit curves, $68\%$ MCMC posterior bands, and the ESA Euclid spectroscopic BAO sensitivity ($\sigma _H/H \approx 1.3\%$ per bin across $0.9 \le z \le 1.8$~\cite {blanchard2020}). (b)~Dark energy equation of state $w(z)$ best-fit trajectories and $68\%$ posterior credible bands. (c)~Progressive model-selection criteria ($\Delta \chi ^2$, $\Delta \mathrm {AIC}$, $\Delta \mathrm {BIC}$) across dataset combinations}{figure.1}{}}
